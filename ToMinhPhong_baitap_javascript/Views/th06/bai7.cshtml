
@{
    ViewBag.Title = "bai7";
}

<head>
    <meta charset="UTF-8">
    <title>Bài 7 - Trò chơi lật ô</title>

    <style>
        body {
            text-align: center;
        }

        #trochoi {
            width: 400px;
            height: 300px;
            margin: 20px auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(3, 1fr);
            background-image: url("https://images.unsplash.com/photo-1604999333679-b86d54738315?q=80&w=1025&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
            background-size: cover;
        }

        .o {
            border: 1px solid black;
            background-color: lightblue;
            cursor: pointer;
        }
    </style>
</head>

<body>
    <h2>TRÒ CHƠI LẬT Ô</h2>
    <p>Bấm vào các ô để khám phá hình nền.</p>

    <div id="trochoi">
        <div class="o" onclick="LatO(this)"></div>
        <div class="o" onclick="LatO(this)"></div>
        <div class="o" onclick="LatO(this)"></div>
        <div class="o" onclick="LatO(this)"></div>

        <div class="o" onclick="LatO(this)"></div>
        <div class="o" onclick="LatO(this)"></div>
        <div class="o" onclick="LatO(this)"></div>
        <div class="o" onclick="LatO(this)"></div>

        <div class="o" onclick="LatO(this)"></div>
        <div class="o" onclick="LatO(this)"></div>
        <div class="o" onclick="LatO(this)"></div>
        <div class="o" onclick="LatO(this)"></div>
    </div>

    <script>function LatO(o) {
            o.style.visibility = "hidden";
        }
    </script>
</body>

