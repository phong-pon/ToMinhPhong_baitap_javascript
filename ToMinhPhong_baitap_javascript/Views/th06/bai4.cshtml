
@{
    ViewBag.Title = "bai4";
}

<head>
    <meta charset="UTF-8">
    <title>Bài 4 - Đổi màu nền</title>
</head>

<body>
    <h2>THAY ĐỔI MÀU NỀN</h2>

    <button onclick="DoiMauXanh()">Xanh</button>
    <button onclick="DoiMauDo()">Đỏ</button>

    <script>function DoiMauXanh() {
            document.body.style.backgroundColor = "blue";
        }

        function DoiMauDo() {
            document.body.style.backgroundColor = "red";
        }</script>
</body>

