
@{
    ViewBag.Title = "bai1";
}

<head>
    <meta charset="UTF-8">
    <title>In các số từ 1 đến N</title>
</head>
<body>
    <h2>IN CÁC SỐ TỪ 1 ĐẾN N</h2>

    <label>Nhập N:</label>
    <input type="number" id="n" min="1">

    <button onclick="InSo()">In số</button>

    <p id="ketQua"></p>

    <script>function InSo() {
            var n = parseInt(document.getElementById("n").value);
            var ketQua = "";

            if (isNaN(n) || n < 1) {
                document.getElementById("ketQua").innerHTML =
                    "Vui lòng nhập N lớn hơn hoặc bằng 1!";
                return;
            }

            for (var i = 1; i <= n; i++) {
                ketQua += i + " ";
            }

            document.getElementById("ketQua").innerHTML = ketQua;
        }</script>
</body>

